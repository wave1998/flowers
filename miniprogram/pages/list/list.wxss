.page {
  padding: 0 24rpx 48rpx;
  min-height: 100vh;
}

.head {
  padding: 40rpx 8rpx 28rpx;
}
.head-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.f-item {
  border-radius: 16rpx;
}
.f-img {
  width: 100%;
  display: block;
  background: #f0ebe4;
}
.f-body {
  padding: 16rpx 20rpx 20rpx;
}
.f-name {
  font-size: 28rpx;
  font-weight: 600;
}
.f-meaning {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-light);
}
