.account-page{padding:48rpx 32rpx}.account-intro{text-align:center;padding:24rpx 0 40rpx}.account-flower{width:100rpx;height:100rpx}.account-title{font-size:44rpx;font-weight:700;margin-top:12rpx}.account-sub,.muted{font-size:24rpx;color:var(--text-light)}.account-sub{margin-top:12rpx}.account-card{padding:36rpx}.login-note{font-size:28rpx;line-height:1.8}.consent{display:flex;align-items:center;flex-wrap:wrap;font-size:24rpx;margin:32rpx 0}.consent checkbox{transform:scale(.8);margin-left:-8rpx}.link{color:var(--primary)}.primary{width:100%;background:var(--primary);color:white;border-radius:48rpx;font-size:28rpx;margin-top:32rpx}.primary::after,.phone-btn::after,.avatar-picker::after{border:0}.avatar-picker{width:100%;background:transparent;display:flex;align-items:center;justify-content:space-between;padding:0;font-size:27rpx;color:var(--text-light)}.avatar{width:120rpx;height:120rpx;border-radius:50%}.field,.phone-field{display:flex;align-items:center;justify-content:space-between;padding:32rpx 0;border-bottom:1rpx solid #f0e8e0;font-size:28rpx}.field input{width:70%;text-align:right}.phone-field .muted{margin-top:8rpx}.phone-btn{width:auto;max-width:180rpx;min-width:0;padding:8rpx 20rpx;margin:0;border-radius:30rpx;color:var(--primary);background:var(--primary-light);font-size:24rpx;line-height:1.6}.tip{margin-top:24rpx;line-height:1.7}.error{margin:24rpx 8rpx;color:#bb425b;font-size:26rpx}.account-footer{display:flex;justify-content:center;gap:40rpx;margin-top:40rpx;font-size:24rpx}.logout{color:var(--text-light)}
