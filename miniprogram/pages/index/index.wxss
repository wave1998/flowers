.page {
  padding: 0 32rpx 48rpx;
}

/* 顶部 */
.hero {
  padding: 40rpx 8rpx 24rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--text);
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  background: var(--card);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 66, 56, 0.05);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}
.search-placeholder {
  font-size: 26rpx;
  color: var(--text-light);
}

/* 初始化卡片 */
.setup-card {
  margin-top: 32rpx;
  padding: 40rpx 36rpx;
  text-align: center;
}
.setup-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.setup-desc {
  font-size: 26rpx;
  color: var(--text-light);
  text-align: left;
  margin-bottom: 32rpx;
}
.setup-btn {
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
  padding: 8rpx 0;
}
.setup-btn[disabled] {
  background: var(--primary-light);
  color: #fff;
}
.setup-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--primary);
}

/* 区块标题 */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 48rpx 8rpx 24rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
}
.section-sub {
  font-size: 24rpx;
  color: var(--text-light);
}
.section-link {
  font-size: 26rpx;
  color: var(--primary);
}

/* 今日推荐卡片 */
.daily-card {
  position: relative;
}
.daily-img {
  width: 100%;
  height: 460rpx;
  display: block;
}
.daily-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 460rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(30, 20, 15, 0.45) 0%, rgba(30, 20, 15, 0) 55%);
}
.daily-name {
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}
.daily-en {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-style: italic;
  margin-top: 4rpx;
}
.daily-body {
  padding: 28rpx 32rpx 32rpx;
}
.daily-meaning {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.meaning-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-right: 16rpx;
}
.meaning-text {
  font-size: 30rpx;
  font-weight: 600;
}
.daily-desc {
  font-size: 26rpx;
  color: var(--text-light);
  margin-bottom: 20rpx;
}
.daily-more {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 26rpx;
  color: var(--primary);
}
.arrow {
  font-size: 32rpx;
  margin-left: 8rpx;
}

/* 骨架屏 */
.skeleton {
  padding: 0;
}
.sk-img {
  height: 460rpx;
  background: linear-gradient(90deg, #f0ebe4 25%, #f7f3ee 50%, #f0ebe4 75%);
  background-size: 400% 100%;
  animation: sk 1.4s ease infinite;
}
.sk-line {
  height: 32rpx;
  margin: 24rpx 32rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0ebe4 25%, #f7f3ee 50%, #f0ebe4 75%);
  background-size: 400% 100%;
  animation: sk 1.4s ease infinite;
}
.w60 { width: 60%; }
.w90 { width: 80%; }
.w40 { width: 40%; }
@keyframes sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* 热门网格 */
.hot-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.hot-img {
  width: 100%;
  height: 220rpx;
  display: block;
}
.hot-name {
  padding: 16rpx 20rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}
.hot-meaning {
  padding: 4rpx 20rpx 20rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

.footer {
  margin-top: 64rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
  letter-spacing: 2rpx;
}
