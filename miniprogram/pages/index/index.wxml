<view class="page">
  <!-- 顶部问候 -->
  <view class="hero">
    <view class="hero-title">花语亭</view>
    <view class="hero-sub">{{today}}</view>
  </view>

  <!-- 搜索框（点击跳转搜索页） -->
  <view class="search-sticky">
    <view class="search-bar" bindtap="goSearch" role="button" aria-label="搜索花卉">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索花的名字或花语，如「玫瑰」</text>
    </view>
  </view>

  <view class="card setup-card" wx:if="{{loadError}}">
    <view class="setup-title">{{loadError.title}}</view>
    <view class="setup-desc">{{loadError.message}}</view>
    <view class="setup-detail" wx:if="{{loadError.detail}}">{{loadError.detail}}</view>
    <button class="setup-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onRetry">重新加载</button>
  </view>

  <!-- 只有查询为空或集合尚未创建时才提示初始化；部分失败支持继续重试。 -->
  <view class="card setup-card" wx:if="{{!loadError && (isEmpty || initError || initializing)}}">
    <view class="setup-title">{{isEmpty ? '🌱 欢迎使用花语亭' : '🌱 花卉数据导入'}}</view>
    <view class="setup-desc" wx:if="{{isEmpty}}">
      数据库还没有花卉数据。配置好云环境并部署 initDatabase 云函数后，可导入内置花卉资料与自由许可图片。导入耗时取决于图片下载速度。
    </view>
    <button class="setup-btn" loading="{{initializing}}" disabled="{{initializing}}" bindtap="onInit">
      {{initializing ? initProgressText : (initError ? '重试导入花卉数据' : '初始化花卉数据')}}
    </button>
    <view class="setup-tip" wx:if="{{initError}}">{{initError}}</view>
  </view>

  <!-- 今日推荐 -->
  <block wx:if="{{daily}}">
    <view class="section-head">
      <text class="section-title">今日花语</text>
      <text class="section-sub">每天认识一朵花</text>
    </view>

    <view class="card daily-card" bindtap="goDetail" data-id="{{daily._id}}">
      <image
        class="daily-img"
        src="{{daily.thumbnail || daily.image}}"
        mode="aspectFill"
        lazy-load
      />
      <view class="daily-overlay">
        <view class="daily-name">{{daily.name}}</view>
        <view class="daily-en">{{daily.nameEn}}</view>
      </view>
      <view class="daily-body">
        <view class="daily-meaning">
          <text class="meaning-label">花语</text>
          <text class="meaning-text">{{daily.meaning}}</text>
        </view>
        <view class="daily-desc ellipsis-2">{{daily.legend}}</view>
        <view class="daily-more">
          <text>查看详情</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 骨架屏 -->
  <view class="card skeleton" wx:if="{{loading}}">
    <view class="sk-img"></view>
    <view class="sk-line w60"></view>
    <view class="sk-line w90"></view>
    <view class="sk-line w40"></view>
  </view>

  <!-- 热门花语（随机几朵） -->
  <block wx:if="{{hot.length}}">
    <view class="section-head">
      <text class="section-title">花间漫步</text>
      <text class="section-link" catchtap="goList">全部 ›</text>
    </view>
    <view class="hot-grid">
      <view
        class="card hot-item"
        wx:for="{{hot}}"
        wx:key="_id"
        bindtap="goDetail"
        data-id="{{item._id}}"
      >
        <image class="hot-img" src="{{item.thumbnail || item.image}}" mode="aspectFill" lazy-load />
        <view class="hot-name">{{item.name}}</view>
        <view class="hot-meaning ellipsis">{{item.meaning}}</view>
      </view>
    </view>
  </block>

  <view class="footer">— 一花一世界，一叶一追寻 —</view>
</view>
