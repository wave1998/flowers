<view class="page">
  <view class="card profile">
    <button class="avatar-btn" bindtap="editAvatar" aria-label="更换头像">
      <image class="avatar" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="avatar-edit">{{user ? '换头像' : '去登录'}}</view>
    </button>
    <view class="profile-info" bindtap="editNickname" role="button" aria-label="修改昵称">
      <view class="nickname">{{nickname || (user ? '花间旅人' : '点击登录')}}</view>
      <view class="profile-desc">{{user ? '编辑昵称与个人资料 ›' : '登录后，收藏属于你的花'}}</view>
    </view>
  </view>
  <view class="account-entry" bindtap="editAccount" role="button">账号与资料<text>{{user && user.phoneBound ? '已绑定手机' : '头像 · 昵称 · 手机号'}} ›</text></view>
  <!-- 统计 -->
  <view class="stats">
    <view class="stat-item">
      <view class="stat-num">{{favorites.length}}</view>
      <view class="stat-label">收藏的花</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">{{favMeanings}}</view>
      <view class="stat-label">种花语</view>
    </view>
  </view>

  <!-- 我的收藏 -->
  <view class="section-head">
    <text class="section-title">🧺 我的花囊</text>
  </view>

  <view class="fav-grid" wx:if="{{favorites.length}}">
    <view
      class="card fav-item"
      wx:for="{{favorites}}"
      wx:key="_id"
      bindtap="goDetail"
      data-id="{{item.flowerId}}"
      bindlongpress="onLongPress"
      data-name="{{item.name}}"
      data-favid="{{item._id}}"
    >
      <image class="fav-img" src="{{item.thumbnail || item.image}}" mode="aspectFill" lazy-load />
      <view class="fav-name">{{item.name}}</view>
      <view class="fav-meaning ellipsis">{{item.meaning}}</view>
    </view>
  </view>

  <view class="empty" wx:elif="{{error}}" bindtap="loadFavorites"><view class="empty-text">{{error}}</view></view>
  <view class="empty" wx:elif="{{!user}}"><view class="empty-icon">🌸</view><view class="empty-text">登录后，把喜欢的花收入花囊</view><button class="go-btn" bindtap="editAccount">去登录</button></view>
  <view class="empty" wx:elif="{{!loading}}">
    <view class="empty-icon">🧺</view>
    <view class="empty-text">花囊还是空的</view>
    <view class="empty-text">去「花丛」逛逛，点 ♡ 收藏喜欢的花</view>
    <button class="go-btn" bindtap="goList">去逛逛</button>
  </view>

  <view class="loading-tip" wx:if="{{loading}}">加载中…</view>

  <!-- 关于 -->
  <view class="about">
    <view class="about-title">关于花语亭</view>
    <view class="about-text">收录 309 条花语资料，含花色等不同条目。花语为文化表达，来源与解读方式详见资料页；插画并非物种照片。</view>
  </view>
</view>
