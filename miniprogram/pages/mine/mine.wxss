.page {
  padding: 32rpx 32rpx 64rpx;
  min-height: 100vh;
}

/* 个人信息卡 */
.profile {
  display: flex;
  align-items: center;
  padding: 40rpx 36rpx;
}
.avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  border: none;
  line-height: 1;
  width: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-btn::after {
  border: none;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #f0ebe4;
  border: 4rpx solid var(--primary-light);
}
.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  box-sizing: border-box;
}
.avatar-edit {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--text-light);
}
.profile-info {
  flex: 1;
  margin-left: 32rpx;
  min-width: 0;
}
.nickname {
  font-size: 36rpx;
  font-weight: 700;
  height: 56rpx;
}
.profile-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

/* 统计 */
.stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 24rpx;
  padding: 32rpx 0;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: 0 4rpx 24rpx rgba(74, 66, 56, 0.06);
}
.stat-item {
  text-align: center;
  flex: 1;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
}
.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-light);
}
.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #eee5db;
}

/* 区块标题 */
.section-head {
  margin: 48rpx 8rpx 24rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

/* 收藏网格 */
.fav-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.fav-img {
  width: 100%;
  height: 240rpx;
  display: block;
  background: #f0ebe4;
}
.fav-name {
  padding: 16rpx 20rpx 0;
  font-size: 28rpx;
  font-weight: 600;
}
.fav-meaning {
  padding: 4rpx 20rpx 20rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

.go-btn {
  margin-top: 40rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  border-radius: 40rpx;
  padding: 4rpx 48rpx;
  width: auto;
  display: inline-block;
}

/* 关于 */
.about {
  margin-top: 72rpx;
  padding: 0 8rpx;
}
.about-title {
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 8rpx;
}
.about-text {
  font-size: 22rpx;
  color: #c2b8ae;
  line-height: 1.7;
}
