.page {
  padding-bottom: 40rpx;
}

.hero-img {
  width: 100%;
  height: 560rpx;
  display: block;
  background: #f0ebe4;
}

.content {
  padding: 32rpx 32rpx 0;
  margin-top: -40rpx;
  position: relative;
  background: var(--bg);
  border-radius: 40rpx 40rpx 0 0;
}

/* 标题行 */
.title-row {
  position: relative;
  min-height: 72rpx;
  padding-right: 184rpx;
}
.favorite-action {
  position: absolute;
  right: 0;
  top: 0;
  width: 160rpx;
}
.name {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.latin {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-light);
  font-style: italic;
}
.fav-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--primary);
  color: var(--primary);
  font-size: 26rpx;
  background: #fff;
}
.fav-btn.faved {
  background: var(--primary);
  color: #fff;
}
.fav-icon {
  font-size: 30rpx;
}

/* 花语卡片 */
.meaning-card {
  margin-top: 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, var(--primary-light) 0%, #fdf3e7 100%);
  border-radius: var(--radius);
}
.meaning-label {
  font-size: 24rpx;
  color: var(--primary);
  margin-bottom: 12rpx;
}
.meaning-text {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
}

/* 信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 28rpx;
}
.info-item {
  background: var(--card);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.info-label {
  font-size: 22rpx;
  color: var(--text-light);
}
.info-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.gift-item {
  grid-column: 1 / -1;
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.gift-label {
  flex: 0 0 186rpx;
  color: #ad7b45;
  font-size: 25rpx;
  font-weight: 600;
}
.gift-value {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  font-size: 27rpx;
  overflow-wrap: break-word;
}

/* 内容区块 */
.section {
  margin-top: 40rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.para {
  font-size: 28rpx;
  color: #5d544a;
  text-align: justify;
  margin-bottom: 16rpx;
}

/* 标签 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 40rpx;
}
.tag {
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  background: #eef3ee;
  color: var(--accent);
  font-size: 24rpx;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
.image-credit {
  margin: 40rpx 0 24rpx;
  font-size: 22rpx;
  color: var(--text-light);
  word-break: break-word;
}
.credit-link {
  margin-top: 8rpx;
  color: var(--primary);
}

.hero{height:560rpx;position:relative;overflow:hidden;background:#eee6df}.hero-img{position:absolute;inset:0}.hero-hd{opacity:0;transition:opacity .35s ease}.hero-hd.is-loaded{opacity:1}.hero-status{position:absolute;bottom:56rpx;right:24rpx;display:flex;align-items:center;padding:8rpx 18rpx;background:rgba(255,255,255,.85);border-radius:30rpx;font-size:21rpx;color:#786960}.petal-spin{width:32rpx;height:32rpx;margin-right:8rpx;animation:petal-turn 2.4s linear infinite}.meaning-note,.meaning-source{font-size:23rpx;line-height:1.7;margin:18rpx 4rpx 0;color:var(--text-light)}.meaning-source{color:var(--primary)}.fav-btn{width:160rpx;max-width:160rpx;flex:0 0 160rpx;box-sizing:border-box;justify-content:center;padding:12rpx 8rpx;min-width:0;margin:0;line-height:1.5}.fav-btn::after{border:0}.skeleton-hero{height:560rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#a88b8d;font-size:26rpx}.skeleton-flower{width:90rpx;height:90rpx;margin:0 0 20rpx}.skeleton-content{padding:36rpx}.skeleton-title{width:42%;height:48rpx;border-radius:10rpx}.skeleton-meaning{height:150rpx;border-radius:24rpx;margin:32rpx 0}.skeleton-line{height:24rpx;border-radius:8rpx;margin-top:20rpx}.skeleton-line:last-child{width:70%}.shimmer{background:linear-gradient(100deg,#f0e8e2 25%,#faf5f0 40%,#f0e8e2 60%);background-size:240% 100%;animation:shimmer 1.8s ease-in-out infinite}.detail-error{padding:140rpx 40rpx;text-align:center;color:var(--text-light)}.detail-error image{width:100rpx;height:100rpx;margin-bottom:30rpx}.detail-error button{margin-top:32rpx;background:var(--primary);color:#fff;border-radius:40rpx;font-size:28rpx}@keyframes petal-turn{to{transform:rotate(360deg)}}@keyframes shimmer{from{background-position:100% 0}to{background-position:-100% 0}}

/* 以缩略图本身的宽高比撑开图片区，高清图在相同区域淡入。 */
.hero { height: auto; background: #fcf1db; }
.hero-preview { position: relative; inset: auto; width: 100%; height: auto; }
.hero-hd { position: absolute; inset: 0; width: 100%; height: 100%; }
.skeleton-hero { height: 750rpx; }
.image-preview { position: fixed; inset: 0; z-index: 1000; background: rgba(20, 17, 16, .96); display: flex; align-items: center; justify-content: center; }
.image-preview-content { width: 100%; height: 100%; }
.image-preview-close { position: absolute; right: 32rpx; top: calc(env(safe-area-inset-top) + 24rpx); color: white; background: rgba(0, 0, 0, .45); border-radius: 32rpx; padding: 12rpx 24rpx; font-size: 26rpx; }
