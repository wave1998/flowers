<view class="page" wx:if="{{flower}}">
  <view class="hero">
    <image class="hero-img hero-preview" src="{{flower.thumbnail || '/images/flower-placeholder.png'}}" mode="widthFix" bindtap="previewImage" binderror="onThumbnailError" />
    <image wx:if="{{!flower.imagePlaceholder && !imageFailed}}" class="hero-img hero-hd {{imageLoaded ? 'is-loaded' : ''}}" src="{{flower.image}}" mode="aspectFit" bindload="onImageLoad" binderror="onImageError" bindtap="previewImage" />
    <view class="hero-status" wx:if="{{flower.imagePlaceholder}}">花卉插画 · 实拍待补充</view>
    <view class="hero-status" wx:elif="{{imageFailed}}" bindtap="retryImage">已显示缩略图 · 点击重试高清图</view>
    <view class="hero-status" wx:elif="{{!imageLoaded}}"><image class="petal-spin" src="/images/flower-loading.png" /> 高清图正在绽放</view>
    <view class="hero-status" wx:else catchtap="previewImage" role="button" aria-label="点击图片预览">点击图片预览</view>
  </view>

  <view class="content">
    <!-- 名称 -->
    <view class="title-row">
      <view>
        <view class="name">{{flower.name}}</view>
        <view class="latin">{{flower.latin || flower.nameEn}}</view>
      </view>
      <view class="favorite-action">
        <button class="fav-btn {{faved ? 'faved' : ''}}" bindtap="onToggleFav" disabled="{{favBusy}}" aria-label="{{faved ? '取消收藏' : '收藏这朵花'}}">
          <text class="fav-icon">{{faved ? '♥' : '♡'}}</text>
          <text>{{favBusy ? '处理中' : (faved ? '已收藏' : '收藏')}}</text>
        </button>
      </view>
    </view>

    <!-- 花语 -->
    <view class="meaning-card">
      <view class="meaning-label">❀ 花语</view>
      <view class="meaning-text">{{flower.meaning}}</view>
    </view>

    <view class="meaning-note">{{flower.meaningNote}}</view>
    <view class="section" wx:if="{{flower.colorMeanings.length}}">
      <view class="section-title">🌸 不同花色的心意</view>
      <view class="meaning-note">以下为花语亭编辑意象解读，花语因文化和个人理解而异。</view>
      <view class="para" wx:for="{{flower.colorMeanings}}" wx:key="name">{{item.name}}：{{item.meaning}}</view>
    </view>
    <view wx:if="{{flower.meaningSource}}" class="meaning-source" bindtap="copyMeaningSource">{{flower.meaningSource.title}} · 复制来源</view>
    <!-- 基本信息 -->
    <view class="info-grid">
      <view class="info-item" wx:if="{{flower.family}}">
        <view class="info-label">科属</view>
        <view class="info-value">{{flower.family}}</view>
      </view>
      <view class="info-item" wx:if="{{flower.bloomSeason}}">
        <view class="info-label">花期</view>
        <view class="info-value">{{flower.bloomSeason}}</view>
      </view>
      <view class="info-item" wx:if="{{flower.origin}}">
        <view class="info-label">原产地</view>
        <view class="info-value">{{flower.origin}}</view>
      </view>
      <view class="info-item" wx:if="{{flower.colors.length}}">
        <view class="info-label">花色</view>
        <view class="info-value">{{flower.colorsText}}</view>
      </view>
      <view class="info-item gift-item" wx:if="{{flower.giftRecipientsText}}">
        <view class="info-label gift-label">💝 适合送给谁</view>
        <view class="info-value gift-value">{{flower.giftRecipientsText}}</view>
      </view>
      <view class="info-item gift-item" wx:if="{{flower.giftOccasionsText}}">
        <view class="info-label gift-label">🎁 适合场景</view>
        <view class="info-value gift-value">{{flower.giftOccasionsText}}</view>
      </view>
    </view>

    <!-- 详细介绍 -->
    <view class="section" wx:if="{{flower.paragraphs.length}}">
      <view class="section-title">🌿 关于{{flower.name}}</view>
      <view class="para" wx:for="{{flower.paragraphs}}" wx:key="index">{{item}}</view>
    </view>

    <!-- 传说 -->
    <view class="section" wx:if="{{flower.legend}}">
      <view class="section-title">📖 花间传说</view>
      <view class="para">{{flower.legend}}</view>
    </view>

    <!-- 养护 -->
    <view class="section" wx:if="{{flower.care}}">
      <view class="section-title">💧 养护小贴士</view>
      <view class="para">{{flower.care}}</view>
    </view>

    <!-- 标签 -->
    <view class="tags" wx:if="{{flower.tags.length}}">
      <view class="tag" wx:for="{{flower.tags}}" wx:key="*this"># {{item}}</view>
    </view>

    <view class="image-credit" wx:if="{{flower.imageMeta}}">
      <view>图片：{{flower.imageMeta.source}} · {{flower.imageMeta.license}}</view>
      <text selectable>{{flower.imageMeta.author}}</text>
      <view wx:if="{{flower.imageMeta.modification}}">{{flower.imageMeta.modification}}</view>
      <view wx:if="{{flower.imageMeta.sourceUrl}}" class="credit-link" bindtap="copyImageSource">复制图片来源链接</view>
    </view>
    <view class="safe-bottom"></view>
  </view>
  <view wx:if="{{previewSrc}}" class="image-preview">
    <image wx:if="{{!previewPreparing}}" class="image-preview-content" src="{{previewSrc}}" mode="aspectFit" bindtap="closePreview" binderror="onPreviewError" />
    <view wx:else class="image-preview-loading"><image class="petal-spin" src="/images/flower-loading.png" />正在准备图片</view>
    <button class="image-preview-close" bindtap="closePreview" aria-label="关闭图片预览">×</button>
    <view class="image-preview-actions"><button class="image-preview-save" bindtap="saveWatermarkedImage" loading="{{savingImage}}" disabled="{{savingImage || previewPreparing}}">↓  保存图片</button></view>
  </view>
  <canvas type="2d" id="watermarkCanvas" class="watermark-canvas"></canvas>
</view>

<view class="detail-skeleton" wx:elif="{{loading}}" aria-label="正在加载花卉详情">
  <view class="skeleton-hero shimmer"><image class="skeleton-flower petal-spin" src="/images/flower-loading.png" /><text>让花语慢慢绽放</text></view>
  <view class="skeleton-content"><view class="skeleton-title shimmer"></view><view class="skeleton-meaning shimmer"></view><view class="skeleton-line shimmer"></view><view class="skeleton-line shimmer"></view></view>
</view>
<view class="detail-error" wx:else><image src="/images/flower-loading.png" /><view>{{error}}</view><button bindtap="loadFlower">重新加载</button></view>
