/* 全局样式 —— 花语亭 */
page {
  --primary: #d4697a;        /* 蔷薇粉 */
  --primary-light: #f6dde1;
  --accent: #7a9e7e;         /* 草木绿 */
  --bg: #faf6f0;             /* 米白 */
  --card: #ffffff;
  --text: #4a4238;           /* 深咖灰 */
  --text-light: #9b9086;
  --radius: 20rpx;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: 0 4rpx 24rpx rgba(74, 66, 56, 0.06);
  overflow: hidden;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
  color: var(--text-light);
}
.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.empty-text {
  font-size: 26rpx;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  color: var(--text-light);
  font-size: 24rpx;
  padding: 32rpx 0;
}
